  "source": "#include \"cpu.hpp\"\n#include \"jit.hpp\"\n#include <chrono>\n#include <iostream>\nint main() {\n pc::CPU c(65536);c.s[pc::CS].big=true;\n const uint8_t bytes[]={0x0f,0xad,0xd8,0x43,0x49,0x75,0xf9};\n for(unsigned n=0;n<sizeof(bytes);++n)c.write(n,bytes[n],1);\n c.r[pc::CX]=10000000;c.r[pc::BX]=0x87654321;c.r[pc::AX]=0x12345678;\n pc::Jit jit(c,true,0);\n auto start=std::chrono::steady_clock::now();\n do {jit.run();} while(c.ip!=sizeof(bytes));\n auto ns=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now()-start).count();\n std::cout<<\"{\\\"ns\\\":\"<<ns<<\",\\\"instructions\\\":\"<<c.instructions<<\",\\\"native\\\":\"<<jit.nativeInstructions<<\",\\\"ax\\\":\"<<c.r[pc::AX]<<\",\\\"bx\\\":\"<<c.r[pc::BX]<<\",\\\"cx\\\":\"<<c.r[pc::CX]<<\",\\\"flags\\\":\"<<c.flags<<\"}\\n\";\n}\n",
