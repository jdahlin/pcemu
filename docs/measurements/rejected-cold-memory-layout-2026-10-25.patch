diff --git a/src/jit_layout.hpp b/src/jit_layout.hpp
new file mode 100644
index 0000000..749cb83
--- /dev/null
+++ b/src/jit_layout.hpp
@@ -0,0 +1,61 @@
+#pragma once
+#include <cstdint>
+#include <cstddef>
+#include <stdexcept>
+#include <utility>
+#include <vector>
+namespace pc::jit_detail {
+// Each range begins with a hot-path B over a self-contained cold region.
+// Remove that B, place the region after the return, and relocate all direct
+// branches. The emitter uses no PC-relative literal loads or ADR instructions.
+inline std::vector<uint32_t> outlineMemoryFallbacks(
+    const std::vector<uint32_t> &code,
+    const std::vector<std::pair<size_t, size_t>> &regions) {
+    std::vector<unsigned char> cold(code.size()), removed(code.size());
+    for (auto [begin, end] : regions) {
+        if (begin >= end || end > code.size() || removed[begin] || cold[begin] ||
+            (code[begin] & 0xfc000000u) != 0x14000000u ||
+            (code[begin] & 0x03ffffffu) != end - begin)
+            throw std::logic_error("invalid JIT cold region");
+        removed[begin] = true;
+        for (size_t n = begin + 1; n < end; ++n) {
+            if (cold[n] || removed[n]) throw std::logic_error("overlapping JIT cold regions");
+            cold[n] = true;
+        }
+    }
+    std::vector<size_t> order, mapping(code.size() + 1);
+    for (bool selectCold : {false, true})
+        for (size_t n = 0; n < code.size(); ++n)
+            if (!removed[n] && bool(cold[n]) == selectCold) {
+                mapping[n] = order.size();
+                order.push_back(n);
+            }
+    mapping[code.size()] = order.size();
+    for (auto it = regions.rbegin(); it != regions.rend(); ++it)
+        mapping[it->first] = mapping[it->second];
+    std::vector<uint32_t> result;
+    result.reserve(order.size());
+    for (auto old : order) {
+        auto word = code[old];
+        unsigned bits = 0, shift = 0;
+        if ((word & 0x7c000000u) == 0x14000000u) bits = 26;
+        else if ((word & 0xff000010u) == 0x54000000u ||
+                 (word & 0x7e000000u) == 0x34000000u) { bits = 19; shift = 5; }
+        else if ((word & 0x7e000000u) == 0x36000000u) { bits = 14; shift = 5; }
+        if (bits) {
+            const uint32_t mask = (1u << bits) - 1;
+            const auto raw = (word >> shift) & mask;
+            const int64_t displacement = int64_t(raw ^ (1u << (bits - 1))) - (1u << (bits - 1));
+            const int64_t target = int64_t(old) + displacement;
+            if (target < 0 || target >= int64_t(code.size()))
+                throw std::logic_error("JIT branch outside block");
+            const int64_t delta = int64_t(mapping[target]) - int64_t(mapping[old]);
+            if (delta < -(int64_t(1) << (bits - 1)) || delta >= (int64_t(1) << (bits - 1)))
+                throw std::logic_error("outlined JIT branch out of range");
+            word = (word & ~(mask << shift)) | ((uint32_t(delta) & mask) << shift);
+        }
+        result.push_back(word);
+    }
+    return result;
+}
+}
