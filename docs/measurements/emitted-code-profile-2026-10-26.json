    "main.cpp": "--- reference/main.cpp\n+++ diagnostic/main.cpp\n@@ -248,7 +248,7 @@\n         }\n         if (snapshotPath.empty())\n             m.boot(fromFloppy);\n-        Jit jit(c, enableJit, 8, 16 * 1024 * 1024,\n+        Jit jit(c, enableJit, 8, 128 * 1024 * 1024,\n                 traceJit ? Jit::BlockMode::Trace\n                          : followJumps ? Jit::BlockMode::FollowJumps : Jit::BlockMode::Basic);\n         std::ofstream trace;\n",
    "jit_arm64.cpp": "--- reference/jit_arm64.cpp\n+++ diagnostic/jit_arm64.cpp\n@@ -3,6 +3,9 @@\n #include \"jit_flags.hpp\"\n #include \"jit_runtime.hpp\"\n #include <algorithm>\n+#include <fstream>\n+#include <cstdlib>\n+#include <unistd.h>\n #include <bit>\n #include <cstddef>\n #include <cstring>\n@@ -280,7 +283,9 @@\n     };\n     std::vector<size_t> exits;\n     int last = -1;\n+    std::vector<size_t> regionOffsets;\n     for (size_t n = 0; n < ir.size(); n++) {\n+        regionOffsets.push_back(code.size()*4);\n         auto i = ir[n];\n         if (i.kind == Kind::Nop)\n             continue;\n@@ -952,6 +957,7 @@\n         dirtyRegisters |= 1u << i.dst;\n         insert(dst, 10, i.w, i.dstShift);\n     }\n+    const auto finishOffset = code.size()*4;\n     flushRegisters(dirtyRegisters);\n     bool branch = ir.back().kind == Kind::Branch;\n     if (!ir.back().nearReturn && !ir.back().indirectJump && !ir.back().indirectCall &&\n@@ -984,6 +990,22 @@\n     std::memcpy(arena + used, code.data(), bytes);\n     pthread_jit_write_protect_np(1);\n     sys_icache_invalidate(arena + used, bytes);\n+    static std::ofstream mapFile(std::getenv(\"PCEMU_JIT_MAP\") ? std::getenv(\"PCEMU_JIT_MAP\") : \"/dev/null\");\n+    if (!mapFile) throw std::runtime_error(\"Cannot write JIT map\");\n+    mapFile << \"{\\\"pid\\\":\" << getpid() << \",\\\"start\\\":\" << reinterpret_cast<uintptr_t>(arena+used)\n+            << \",\\\"end\\\":\" << reinterpret_cast<uintptr_t>(arena+used+bytes)\n+            << \",\\\"recycles\\\":\" << cacheRecycles << \",\\\"ip\\\":\" << cpu.ip\n+            << \",\\\"cs\\\":\" << cpu.s[CS].selector << \",\\\"regions\\\":[{\\\"offset\\\":0,\\\"kind\\\":\\\"prologue\\\"}\";\n+    const char *names[]={\"Move\",\"Alu\",\"Test\",\"Nop\",\"Branch\",\"Memory\",\"Lea\",\"CounterBranch\",\"Exchange\",\"Multiply\",\"Shift\",\"IndirectJump\",\"MultiplyByte\",\"DoubleShift\",\"BitTest\",\"LoadFlags\"};\n+    for (size_t n=0;n<ir.size();++n) {\n+        const auto &i=ir[n];\n+        mapFile << \",{\\\"offset\\\":\" << regionOffsets[n] << \",\\\"kind\\\":\\\"\" << names[int(i.kind)]\n+                << \"\\\",\\\"width\\\":\" << i.w << \",\\\"store\\\":\" << i.memory.store\n+                << \",\\\"stackDelta\\\":\" << i.stackDelta << \",\\\"call\\\":\" << i.nearCall\n+                << \",\\\"return\\\":\" << i.nearReturn << \",\\\"memoryCall\\\":\" << i.memoryCall\n+                << \",\\\"memoryPush\\\":\" << i.memoryPush << \",\\\"op\\\":\" << i.op << \"}\";\n+    }\n+    mapFile << \",{\\\"offset\\\":\" << finishOffset << \",\\\"kind\\\":\\\"finish\\\"}]}\\n\";\n     block.fn = reinterpret_cast<Function>(arena + used);\n     used = (used + bytes + 15) & ~size_t(15);\n     compiledBlocks++;\n"
