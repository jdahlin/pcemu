-    struct TLBEntry {
-        uint32_t tag = 0, epoch = 0, base = 0, pteAddress = 0;
-        uint8_t permissions = 0;
-        bool dirty = false;
+    struct alignas(8) TLBEntry {
+        uint32_t tag = 0, epoch = 0, frameFlags = 0, pteAddress = 0;
+        TLBEntry() = default;
+        constexpr TLBEntry(uint32_t tag, uint32_t epoch, uint32_t base, uint32_t pte,
+                           uint8_t permissions, bool dirty)
+            : tag(tag), epoch(epoch),
+              frameFlags((base >> 12) | (uint32_t(permissions) << 20) | (uint32_t(dirty) << 28)),
+              pteAddress(pte) {}
+        constexpr uint32_t base() const { return frameFlags << 12; }
+        constexpr uint8_t permissions() const { return (frameFlags >> 20) & 255; }
+        constexpr bool dirty() const { return frameFlags & (1u << 28); }
+        void setDirty() { frameFlags |= 1u << 28; }
     };
     std::array<TLBEntry, 1024> tlb{};
     uint32_t tlbEpoch = 1, tlbCR3 = 0xffffffffu;
