+    // Keep ordinary translations at the caller. Faults, walks, CR3 changes
+    // and first writes still use the full path, with its precise side effects.
+    [[gnu::always_inline]] uint32_t physical(uint32_t linear, bool write = false) {
+        uint32_t translated = linear;
+        if (cr[0] & 0x80000000u) {
+            uint32_t page = linear >> 12;
+            const auto &entry = tlb[(page ^ (page >> 10)) & (tlb.size() - 1)];
+            bool user = cpl() == 3 && !systemAccess;
+            if (tlbCR3 != cr[3] || entry.epoch != tlbEpoch || entry.tag != page ||
+                (user && (!(entry.permissions & 4) || (write && !(entry.permissions & 2)))) ||
+                (write && !entry.dirty))
+                return physicalSlow(linear, write);
+            translated = entry.base | (linear & 4095);
+        }
+        return a20 ? translated : translated & ~(1u << 20);
+    }
