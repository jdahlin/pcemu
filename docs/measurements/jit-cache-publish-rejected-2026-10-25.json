  "source": "#include \"jit.hpp\"\n#include <algorithm>\n#include <chrono>\n#include <iostream>\n#include <stdexcept>\nusing namespace pc;\nint main(int argc,char **argv) {\n try {\n  unsigned loops=argc>1?std::stoul(argv[1]):1000000;\n  bool enabled=argc<3 || std::string(argv[2])!=\"interpreter\";\n  if(!loops || loops>10000000) throw std::runtime_error(\"Invalid loop count\");\n  std::cout << \"[\";\n  bool first=true;\n  for(bool code32:{false,true}) for(bool stack32:{false,true}) for(bool paging:{false,true}) {\n   CPU c(1024*1024);\n   c.cr[0]=0x11;\n   c.s[CS].big=code32; c.s[CS].limit=code32?UINT32_MAX:65535;\n   c.s[SS].big=stack32; c.s[SS].base=0x10000; c.s[SS].limit=UINT32_MAX;\n   c.r[AX]=0x100; c.r[CX]=loops; c.r[DX]=0; c.r[SP]=0x7000;\n   std::vector<uint8_t> code={0xff,0xd0};\n   if(!code32) code.push_back(0x66);\n   code.insert(code.end(),{0x83,0xe9,1,0x75,uint8_t(-int(code.size()+5))});\n   auto end=code.size(); code.push_back(0xf4);\n   std::copy(code.begin(),code.end(),c.mem.begin());\n   c.mem[0x100]=0x83;c.mem[0x101]=0xc2;c.mem[0x102]=1;c.mem[0x103]=0xc3;\n   if(paging) {\n    c.write(0x80000,0x81007,4);\n    for(unsigned p=0;p<256;++p)c.write(0x81000+4*p,(p<<12)|7,4);\n    c.cr[3]=0x80000;c.cr[0]|=0x80000000;c.flushTLB();\n   }\n   Jit jit(c,enabled);\n   auto start=std::chrono::steady_clock::now();\n   while(c.ip!=end && c.instructions<=uint64_t(loops)*5)jit.run();\n   double sec=std::chrono::duration<double>(std::chrono::steady_clock::now()-start).count();\n   if(c.ip!=end || c.r[CX] || c.r[DX]!=(code32?loops:loops&65535) || c.r[SP]!=0x7000 || c.instructions!=uint64_t(loops)*5)\n    throw std::runtime_error(\"CALL/RET count, stack, destination or checksum mismatch\");\n   if(!first)std::cout << \",\";first=false;\n   std::cout << \"{\\\"code32\\\":\"<<code32<<\",\\\"stack32\\\":\"<<stack32<<\",\\\"paging\\\":\"<<paging<<\",\\\"loops\\\":\"<<loops<<\",\\\"instructions\\\":\"<<c.instructions<<\",\\\"native\\\":\"<<jit.nativeInstructions<<\",\\\"checksum\\\":\"<<c.r[DX]<<\",\\\"seconds\\\":\"<<sec<<\"}\"<<std::flush;\n  }\n  std::cout << \"]\\n\";\n }catch(const std::exception &e){std::cerr<<e.what()<<'\\n';return 1;}\n}\n",
